// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
    "name": "Node 24 & TypeScript",
    "build": {
        // Path is relative to the devcontainer.json file.
        "dockerfile": "Dockerfile"
    },
    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "./.devcontainer/setup.sh",
    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "extensions": [
                "eamodio.gitlens",
                "astro-build.astro-vscode",
                "vitest.explorer",
                "bradlc.vscode-tailwindcss",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "DavidAnson.vscode-markdownlint",
                "EditorConfig.EditorConfig",
                "ChaitanyaShahare.lazygit",
                "unifiedjs.vscode-mdx"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/copilot-cli:1.1.3": {}
    },
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/tmp/.gitconfig-host,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached",
        "type=volume,target=${containerWorkspaceFolder}/node_modules"
    ],
    "appPort": [3000]
}
