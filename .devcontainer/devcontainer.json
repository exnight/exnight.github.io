{
    "name": "Website — Node 26 & Pi",
    "image": "dev-agent:node26",
    "remoteUser": "devops",
    "init": true,
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "containerEnv": {
        "ASTRO_TELEMETRY_DISABLED": "1",
        "IS_CONTAINER": "true",
        "GIT_SSH_COMMAND": "ssh"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "astro-build.astro-vscode",
                "bradlc.vscode-tailwindcss",
                "unifiedjs.vscode-mdx",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "[astro]": {
                    "editor.defaultFormatter": "astro-build.astro-vscode"
                },
                "editor.quickSuggestions": {
                    "strings": "on"
                }
            }
        }
    },
    "postCreateCommand": "npm ci",
    "mounts": [
        "source=${localEnv:HOME}/dev-tools/dev-agent,target=/opt/dev-agent,type=bind,readonly",
        "source=dev-agent-home,target=/home/devops/.pi/agent,type=volume",
        "source=dev-agent-${localWorkspaceFolderBasename}-sessions,target=/home/devops/.pi/sessions,type=volume"
    ],
    "forwardPorts": [
        3000,
        4321
    ]
}
