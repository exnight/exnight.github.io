---
import PostEntry from '@/components/PostEntry.astro'
import Sketch from '@/components/Sketch.astro'
import { getBlogPosts } from '@/lib/posts'

const posts = await getBlogPosts()
const recentPosts = posts.filter((post) => post.data.published).slice(0, 2)
const groups = [
  {
    title: 'Profession',
    items: ['Backend applications', 'Data pipelines', 'Cloud infrastructure', 'CI/CD automation'],
  },
  {
    title: 'Beyond work',
    items: ['Travelling', 'Competitive gaming', 'Photography', 'Basketball'],
  },
]
---

<div class="n-wrap">
  <section
    class="n-hero grid grid-cols-12 grid-rows-[auto_auto_1fr] items-start gap-x-6 pt-[clamp(3rem,7vw,6rem)]"
    id="home"
    aria-labelledby="hero-title"
  >
    <h1
      id="hero-title"
      class="n-hero__statement stacked:col-span-full compact:text-[clamp(2.35rem,11vw,3rem)] col-span-8 m-0 text-[clamp(2.7rem,5.6vw,5.2rem)] leading-none font-[650] tracking-[-0.028em] text-balance font-stretch-90%"
    >
      I <span class="n-mark-under relative whitespace-nowrap"
        >build software<Sketch
          kind="underline"
          class="absolute bottom-[-0.14em] left-[-2%] h-[0.2em] w-[104%] [&_path]:stroke-3"
        /></span
      > and keep <span class="n-mark-high relative whitespace-nowrap"
        ><Sketch kind="highlight" class="absolute top-[20%] left-[-6%] z-0 h-[72%] w-[112%]" /><span
          class="relative z-1">notes</span
        ></span
      > on what I learn.
    </h1>
    <p
      class="n-hero__detail text-soft-ink stacked:col-span-full col-span-7 m-0 mt-[clamp(1.75rem,3vw,2.5rem)] max-w-[64ch] font-serif text-[clamp(1.1rem,1.4vw,1.25rem)] leading-[1.6] text-pretty"
    >
      I love automation and I create tools for the team to improve the quality of life. I also write
      about travelling, competitive gaming, photography, and basketball.
    </p>
    <aside
      class="n-profile stacked:col-span-full stacked:row-auto stacked:mt-11 stacked:grid stacked:grid-cols-2 stacked:gap-8 stacked:justify-self-stretch col-span-4 col-start-9 row-span-3 row-start-1 justify-self-end"
      aria-label="Profession and interests"
    >
      {
        groups.map((group) => (
          <section class="n-profile__group stacked:[&+&]:mt-0 [&+&]:mt-9" aria-label={group.title}>
            <>
              <h2 class="text-pen m-0 mb-[0.8rem] text-[1.05rem] font-semibold">{group.title}</h2>
              <ul class="m-0 list-none p-0">
                {group.items.map((item) => (
                  <li class="text-soft-ink py-1 text-base leading-normal">{item}</li>
                ))}
              </ul>
            </>
          </section>
        ))
      }
    </aside>
  </section>
</div>
<section
  class="n-wrap n-log mt-[clamp(4rem,8vw,7rem)] pb-[clamp(3.5rem,7vw,5.5rem)]"
  id="writing"
  aria-labelledby="writing-heading"
>
  <h2
    id="writing-heading"
    class="n-section-title relative m-0 mb-7 inline-block text-[clamp(1.8rem,3vw,2.6rem)] font-[650] tracking-[-0.03em] font-stretch-90%"
  >
    Recent writing<Sketch
      kind="underline"
      class="n-section-title__mark absolute bottom-[-0.25em] left-0 h-[0.22em] w-full"
    />
  </h2>
  <ol class="n-log__list compact:-mx-3 m-0 -mx-4 grid list-none gap-[0.35rem] p-0">
    {
      recentPosts.map((post) => (
        <li>
          <PostEntry post={post} />
        </li>
      ))
    }
  </ol>
  <a
    class="n-all text-pen mt-5 inline-block font-mono text-[0.85rem] font-normal no-underline [&:hover]:underline [&:hover]:decoration-wavy [&:hover]:underline-offset-[0.3em]"
    href="/blog">All writing →</a
  >
</section>
