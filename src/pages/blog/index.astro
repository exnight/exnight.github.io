---
import Layout from '@/layouts/Layout.astro'
import PostGrid from '@/components/PostGrid.astro'
import Section from '@/components/Section.astro'
---

<Layout>
  <Section>
    <div class="min-vh-minus-header mx-auto w-10/12 space-y-8 lg:w-3/4">
      <h1 class="mb-4 pt-16 text-5xl font-bold md:text-6xl">Blog</h1>
      <p class="text-md text-(--text-muted)">
        Thoughts on software engineering, technology, and my hobbies.
      </p>
      <PostGrid />
    </div>
  </Section>
</Layout>
