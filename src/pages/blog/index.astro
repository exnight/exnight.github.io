---
import Layout from '@/layouts/Layout.astro'
import PostGrid from '@/components/PostGrid.astro'
import Section from '@/components/Section.astro'
---

<Layout>
  <Section class="writing-index-page">
    <div class="site-frame page-shell">
      <header class="page-heading writing-index-heading">
        <div>
          <h1>My Posts</h1>
          <p>Technical notes and personal interests, newest first.</p>
        </div>
        <p class="writing-index-heading__note">I publish new posts from time to time.</p>
      </header>

      <PostGrid />
    </div>
  </Section>
</Layout>
