---
import { render } from 'astro:content'

import Layout from '@/layouts/Layout.astro'
import ArrowIcon from '@/components/ArrowIcon.astro'
import ExternalLink from '@/components/ExternalLink.astro'
import PostMeta from '@/components/PostMeta.astro'
import Section from '@/components/Section.astro'
import TableOfContents from '@/components/TableOfContents.astro'

import { DATE_FORMAT_DISPLAY, blogPosts } from '@/utils'

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, publishedOn, updatedOn, summary, tags } = post.data
const { Content, headings } = await render(post)
const articleProseClass =
  'markdown-content article-prose prose text-article-body max-[720px]:text-article-body-mobile max-w-[72ch] text-ink-soft [--tw-prose-body:var(--ink-soft)] [--tw-prose-headings:var(--ink)] [--tw-prose-lead:var(--muted)] [--tw-prose-links:var(--vermilion)] [--tw-prose-bold:var(--ink)] [--tw-prose-counters:var(--muted)] [--tw-prose-bullets:var(--line)] [--tw-prose-hr:var(--line)] [--tw-prose-quotes:var(--muted)] [--tw-prose-quote-borders:var(--vermilion)] [--tw-prose-captions:var(--muted)] [--tw-prose-code:var(--ink)] [--tw-prose-pre-code:var(--folio-ink)] [--tw-prose-pre-bg:var(--folio)] [--tw-prose-th-borders:var(--line)] [--tw-prose-td-borders:var(--line)] [&>:first-child]:mt-0 prose-headings:font-display prose-headings:font-[570] prose-headings:tracking-[-0.02em] prose-headings:text-ink prose-headings:text-balance prose-headings:scroll-mt-[calc(var(--header-height)+2rem)] prose-h2:text-article-h2 prose-h2:mt-[3.8rem] prose-h2:mb-[1.1rem] prose-h3:text-article-h3 prose-h3:mt-[2.8rem] prose-h3:mb-[0.9rem] prose-h4:my-[1.33em] prose-h4:text-[1em] prose-p:my-[1.35rem] prose-ul:my-[1.35rem] prose-ul:list-none prose-ul:pl-0 prose-ol:my-[1.35rem] prose-ol:list-none prose-ol:pl-0 prose-li:my-0 prose-a:font-bold prose-a:text-vermilion prose-a:no-underline prose-blockquote:my-[1.35rem] prose-blockquote:border-l prose-blockquote:border-vermilion prose-blockquote:py-[0.4rem] prose-blockquote:pr-0 prose-blockquote:pl-[1.4rem] prose-blockquote:font-display prose-blockquote:text-[1.2em] prose-blockquote:font-normal prose-blockquote:text-muted prose-blockquote:italic prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:my-[1.35rem] prose-img:my-0 prose-img:max-w-full prose-table:my-0 prose-table:w-full prose-table:max-w-full prose-table:border-collapse prose-table:text-[1em] prose-table:leading-[inherit] prose-table:[font-variant-numeric:lining-nums_tabular-nums] prose-th:border-b prose-th:border-line prose-th:p-3 prose-th:text-left prose-td:border-b prose-td:border-line prose-td:p-3 prose-td:text-left [&_blockquote_p:first-of-type::before]:content-none [&_blockquote_p:last-of-type::after]:content-none'
---

<Layout title={title} description={summary}>
  <Section class="pt-[clamp(2rem,5vw,5rem)]">
    <div class="site-frame max-w-305">
      <a
        class="text-control text-muted hover:text-vermilion mb-[clamp(2.5rem,5vw,5rem)] inline-flex items-center gap-[0.6rem] font-bold tracking-[0.12em] uppercase no-underline"
        href="/blog"
      >
        <ArrowIcon class="size-4.5" direction="left" />
        All writing
      </a>

      <header class="border-line max-w-245 border-b pb-[clamp(2.5rem,5vw,5rem)]">
        <PostMeta publishedOn={publishedOn} tags={tags} variant="article" />
        <h1
          class="font-display text-article-title max-[720px]:text-article-title-mobile m-0 max-w-[18ch] font-[510] tracking-[-0.035em] text-balance lining-nums"
          transition:name={`${post.id}-title`}
        >
          {title}
        </h1>
        {
          summary ? (
            <p class="text-article-deck text-muted mt-7 max-w-[64ch] leading-[1.7]">{summary}</p>
          ) : null
        }
        {
          updatedOn ? (
            <p class="text-meta text-muted mt-[1.4rem] font-bold tracking-[0.14em] italic">
              Updated{' '}
              <time datetime={updatedOn.toISOString()}>
                {updatedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
              </time>
            </p>
          ) : null
        }
      </header>

      {
        headings.length ? (
          <details class="bg-paper-raised rounded-panel border-line mt-8 hidden border max-[980px]:block">
            <summary class="text-control cursor-pointer px-[1.2rem] py-4 font-bold tracking-[0.12em] uppercase marker:list-inside">
              On this page
            </summary>
            <TableOfContents headings={headings} variant="mobile" />
          </details>
        ) : null
      }

      <div
        class="grid grid-cols-[minmax(0,1fr)_250px] items-start gap-[clamp(3rem,7vw,7rem)] pt-[clamp(3rem,6vw,6rem)] max-[980px]:grid-cols-1 max-[720px]:pt-12"
      >
        <article class={articleProseClass}>
          <Content components={{ a: ExternalLink }} />
        </article>

        {
          headings.length ? (
            <aside class="sticky top-[calc(var(--header-height)+2rem)] max-[980px]:hidden">
              <TableOfContents headings={headings} />
            </aside>
          ) : null
        }
      </div>
    </div>
  </Section>
</Layout>
