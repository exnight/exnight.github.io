---
import { render } from 'astro:content'

import Layout from '@/layouts/Layout.astro'
import ArrowIcon from '@/components/ArrowIcon.astro'
import ExternalLink from '@/components/ExternalLink.astro'
import Section from '@/components/Section.astro'
import TableOfContents from '@/components/TableOfContents.astro'

import { DATE_FORMAT_DISPLAY, blogPosts } from '@/utils'

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, publishedOn, updatedOn, summary, tags } = post.data
const { Content, headings } = await render(post)
const articleProseClass =
  'markdown-content article-prose prose text-article-body max-[720px]:text-article-body-mobile w-full max-w-none text-ink-soft [--tw-prose-body:var(--ink-soft)] [--tw-prose-headings:var(--ink)] [--tw-prose-lead:var(--muted)] [--tw-prose-links:var(--vermilion)] [--tw-prose-bold:var(--ink)] [--tw-prose-counters:var(--muted)] [--tw-prose-bullets:var(--line)] [--tw-prose-hr:var(--line)] [--tw-prose-quotes:var(--muted)] [--tw-prose-quote-borders:var(--vermilion)] [--tw-prose-captions:var(--muted)] [--tw-prose-code:var(--ink)] [--tw-prose-pre-code:var(--folio-ink)] [--tw-prose-pre-bg:var(--folio)] [--tw-prose-th-borders:var(--line)] [--tw-prose-td-borders:var(--line)] [&>:first-child]:mt-0 prose-headings:font-display prose-headings:font-[570] prose-headings:tracking-[-0.02em] prose-headings:text-ink prose-headings:text-balance prose-headings:scroll-mt-[calc(var(--header-height)+2rem)] prose-h2:text-article-h2 prose-h2:mt-[3.8rem] prose-h2:mb-[1.1rem] prose-h3:text-article-h3 prose-h3:mt-[2.8rem] prose-h3:mb-[0.9rem] prose-h4:my-[1.33em] prose-h4:text-[1em] prose-p:my-[1.35rem] prose-ul:my-[1.35rem] prose-ul:list-disc prose-ul:pl-[1.4rem] prose-ol:my-[1.35rem] prose-ol:list-decimal prose-ol:pl-[1.4rem] prose-li:my-[0.4rem] prose-li:pl-[0.3rem] marker:text-line prose-a:font-bold prose-a:text-vermilion prose-a:no-underline prose-blockquote:my-[1.35rem] prose-blockquote:border-l prose-blockquote:border-vermilion prose-blockquote:py-[0.4rem] prose-blockquote:pr-0 prose-blockquote:pl-[1.4rem] prose-blockquote:font-display prose-blockquote:text-[1.2em] prose-blockquote:font-normal prose-blockquote:text-muted prose-blockquote:italic prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:my-[1.35rem] prose-img:my-0 prose-img:max-w-full prose-table:my-0 prose-table:w-full prose-table:max-w-full prose-table:border-collapse prose-table:text-[1em] prose-table:leading-[inherit] prose-table:[font-variant-numeric:lining-nums_tabular-nums] prose-th:border-b prose-th:border-line prose-th:p-3 prose-th:text-left prose-td:border-b prose-td:border-line prose-td:p-3 prose-td:text-left [&_blockquote_p:first-of-type::before]:content-none [&_blockquote_p:last-of-type::after]:content-none'
---

<Layout title={title} description={summary}>
  <Section class="pt-[clamp(2rem,5vw,5rem)]">
    <a
      class="text-control text-muted hover:text-vermilion mb-[clamp(2.5rem,5vw,5rem)] inline-flex items-center gap-[0.6rem] font-bold tracking-[0.12em] uppercase no-underline"
      href="/blog"
    >
      <ArrowIcon class="size-4.5" direction="left" />
      All writing
    </a>

    <div
      class="grid w-full grid-cols-[minmax(0,1fr)_18rem] items-start gap-x-[clamp(2.5rem,5vw,3rem)] max-[980px]:grid-cols-1"
    >
      <header class="article-header border-line col-start-1 row-start-1 min-w-0 border-b">
        <h1
          class="font-display text-article-title max-[720px]:text-article-title-mobile m-0 max-w-none font-[510] tracking-[-0.035em] text-balance wrap-break-word lining-nums"
          transition:name={`${post.id}-title`}
        >
          {title}
        </h1>
        {
          summary ? (
            <p class="article-header__summary text-article-deck text-muted leading-[1.7]">
              {summary}
            </p>
          ) : null
        }
        <dl
          class="article-header__meta border-line-soft text-meta grid gap-x-8 font-bold tracking-[0.14em] uppercase"
        >
          <div class="article-header__field">
            <dt class="text-vermilion">Published</dt>
            <dd class="text-muted m-0">
              <time datetime={publishedOn.toISOString()}>
                {publishedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
              </time>
            </dd>
          </div>
          {
            updatedOn ? (
              <div class="article-header__field">
                <dt class="text-vermilion">Updated</dt>
                <dd class="text-muted m-0">
                  <time datetime={updatedOn.toISOString()}>
                    {updatedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
                  </time>
                </dd>
              </div>
            ) : null
          }
          {
            tags.length ? (
              <div class="article-header__field article-header__topics">
                <dt class="text-vermilion">Topics</dt>
                <dd class="text-muted m-0">{tags.join(' / ')}</dd>
              </div>
            ) : null
          }
        </dl>
      </header>

      {
        headings.length ? (
          <aside class="sticky top-[calc(var(--header-height)+2rem)] col-start-2 row-span-2 row-start-1 w-full self-start max-[980px]:hidden">
            <TableOfContents headings={headings} />
          </aside>
        ) : null
      }

      {
        headings.length ? (
          <details class="bg-paper-raised rounded-panel border-line col-start-1 row-start-2 mt-6 hidden border max-[980px]:block">
            <summary class="text-control cursor-pointer px-[1.2rem] py-4 font-bold tracking-[0.12em] uppercase marker:list-inside">
              On this page
            </summary>
            <TableOfContents headings={headings} variant="mobile" />
          </details>
        ) : null
      }

      <article
        class:list={[
          articleProseClass,
          'col-start-1 pt-[clamp(2rem,3vw,3rem)] max-[720px]:pt-10',
          headings.length ? 'row-start-2 max-[980px]:row-start-3' : 'row-start-2',
        ]}
      >
        <Content components={{ a: ExternalLink }} />
      </article>
    </div>
  </Section>
</Layout>

<style is:global>
  .article-header {
    padding-bottom: clamp(1.75rem, 3vw, 2.75rem);
  }

  .article-header__summary {
    max-width: none;
    margin-top: 1.25rem;
  }

  .article-header__meta {
    grid-template-columns: max-content max-content minmax(14rem, 1fr);
    align-items: baseline;
    margin-top: 1.5rem;
    padding-top: 0;
  }

  .article-header__field {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    min-width: 0;
    line-height: 1.55;
  }

  .article-header__topics {
    grid-column: -2 / -1;
    justify-self: end;
    text-align: right;
  }

  .article-prose .katex-display {
    margin-block: 1.35rem;
  }

  .article-prose a {
    color: var(--vermilion);
  }

  .article-prose code:not(pre code) {
    padding: 0.12em 0.32em;
    border-radius: var(--radius-control);
    background: var(--paper-sage);
    color: var(--ink);
    font-size: 0.9em;
  }

  .article-prose pre {
    padding: 1.4rem;
    border: 1px solid var(--line-soft);
    border-radius: 11px;
    box-shadow: 0 10px 24px var(--shadow);
  }

  .article-prose .astro-code,
  .article-prose .astro-code span {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
    text-decoration: var(--shiki-light-text-decoration);
  }

  .dark .article-prose .astro-code,
  .dark .article-prose .astro-code span {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
    font-style: var(--shiki-dark-font-style);
    font-weight: var(--shiki-dark-font-weight);
    text-decoration: var(--shiki-dark-text-decoration);
  }

  @media (max-width: 1180px) {
    .article-header__meta {
      grid-template-columns: max-content max-content;
      row-gap: 0.8rem;
    }

    .article-header__topics {
      grid-column: 1 / -1;
      justify-self: start;
      text-align: left;
    }
  }

  @media (max-width: 720px) {
    .article-header__meta {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-header__topics {
      grid-column: auto;
      justify-self: start;
      text-align: left;
    }

    .article-prose pre {
      width: calc(100vw - 2.25rem);
      max-width: 100%;
    }
  }
</style>
