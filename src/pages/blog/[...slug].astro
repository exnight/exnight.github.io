---
import { render } from 'astro:content'
import { fade } from 'astro:transitions'

import Layout from '@/layouts/Layout.astro'
import ExternalLink from '@/components/ExternalLink.astro'
import { DATE_FORMAT_DISPLAY, blogPosts } from '@/utils'

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, publishedOn, updatedOn } = post.data
const { Content } = await render(post)
---

<Layout>
  <div
    class="mx-auto grid w-10/12 grid-cols-1 space-y-6 pb-8 lg:w-3/4 lg:grid-cols-[1fr_clamp(250px,20%,300px)]"
  >
    <!-- Main Article -->
    <article
      class="prose dark:prose-invert prose-zinc md:prose-base prose-p:text-lg prose-p:leading-relaxed prose-h1:text-4xl prose-h1:font-bold prose-h1:mb-2 prose-h1:mt-8 prose-h2:text-2xl prose-h2:font-bold prose-h2:mb-4 prose-h2:mt-8 prose-h2:scroll-mt-20 prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-6 prose-h3:mb-3 prose-a:text-primary prose-a:font-medium prose-code:text-sm prose-code:font-mono prose-code:px-2 prose-code:py-1 prose-code:rounded prose-code:bg-neutral-200 dark:prose-code:bg-neutral-800 prose-pre:rounded-lg prose-pre:border prose-pre:border-border prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:pl-4 prose-li:text-lg prose-li:leading-relaxed max-w-3xl px-4 md:px-0"
      transition:name={post.id}
      transition:animate={fade({ duration: '0.7s' })}
    >
      <!-- Article Header -->
      <div class="not-prose my-8">
        <h1 transition:name={`${post.id}-title`} class="mb-4 text-4xl font-bold md:text-5xl">
          {title}
        </h1>
      </div>

      <!-- Content -->
      <Content components={{ a: ExternalLink }} />
    </article>

    <!-- Sidebar (Desktop Only) -->
    <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start lg:pl-8">
      <div class="space-y-6 text-sm text-(--text-muted)">
        <div>
          <h3 class="mb-3">Published</h3>
          <p>{publishedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}</p>
        </div>
        {
          updatedOn && (
            <div>
              <h3 class="text-foreground mb-3">Last updated</h3>
              <p>{updatedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}</p>
            </div>
          )
        }
        <nav class="border-t pt-4">
          <a href="/blog" class="text-primary hover:text-primary/80 inline-flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              class="fill-current"
            >
              <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"></path>
            </svg>
            Back to Blog
          </a>
        </nav>
      </div>
    </aside>
  </div>
</Layout>
