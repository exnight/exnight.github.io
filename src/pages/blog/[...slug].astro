---
import { render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import '@/styles/article/index.css'
import ExternalLink from '@/components/ExternalLink.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import NotebookTable from '@/components/NotebookTable.astro'
import PostMeta from '@/components/PostMeta.astro'
import { getBlogPosts } from '@/lib/posts'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}
const { post } = Astro.props
const { title, summary } = post.data
const { Content, headings } = await render(post)
---

<Layout title={title} description={summary}>
  <article class="n-wrap n-article pt-[clamp(1.5rem,3vw,2.5rem)] pb-[clamp(4rem,8vw,6rem)]">
    <header class="n-article__head pb-[clamp(2.25rem,4vw,3.5rem)] wrap-anywhere">
      <p
        class="n-crumbs text-muted mb-[clamp(2rem,4vw,3.5rem)] flex flex-wrap gap-2 font-mono text-[0.8rem] font-normal"
      >
        <a
          class="text-pen no-underline [&:hover]:underline [&:hover]:decoration-wavy [&:hover]:underline-offset-[0.25em]"
          href="/blog">← Back to Writing</a
        >
      </p>
      <h1
        class="m-0 max-w-[22ch] text-[clamp(2.5rem,5.4vw,4.6rem)] leading-none font-[650] tracking-[-0.035em] text-balance font-stretch-90%"
        transition:name={`${post.id}-title`}
      >
        {title}
      </h1>
      {
        summary && (
          <p class="n-deck text-soft-ink mt-[1.1rem] mb-0 max-w-[60ch] font-serif text-[clamp(1.15rem,1.6vw,1.35rem)] leading-[1.45] text-pretty italic">
            {summary}
          </p>
        )
      }
      <PostMeta data={post.data} article />
    </header>
    <TableOfContents headings={headings} />
    <div class="n-prose markdown-content">
      <Content components={{ a: ExternalLink, table: NotebookTable }} />
    </div>
  </article>
</Layout>
<script>
  import { initTables } from '@/scripts/article'
  let cleanup: (() => void) | undefined
  function initialize() {
    cleanup?.()
    cleanup = initTables()
  }
  initialize()
  document.addEventListener('astro:page-load', initialize)
  document.addEventListener('astro:before-swap', () => {
    cleanup?.()
    cleanup = undefined
  })
</script>
