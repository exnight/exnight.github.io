---
import { render } from 'astro:content'

import Layout from '@/layouts/Layout.astro'
import ExternalLink from '@/components/ExternalLink.astro'
import Section from '@/components/Section.astro'
import TableOfContents from '@/components/TableOfContents.astro'

import { DATE_FORMAT_DISPLAY, blogPosts } from '@/utils'

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, publishedOn, updatedOn, summary, tags } = post.data
const { Content, headings } = await render(post)
---

<Layout title={title} description={summary}>
  <Section class="article-page">
    <div class="site-frame article-shell">
      <a class="back-link" href="/blog">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        All writing
      </a>

      <header class="article-header">
        <div class="article-header__meta">
          <time datetime={publishedOn.toISOString()}>
            {publishedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
          </time>
          {tags?.length ? <span>{tags.join(' / ')}</span> : null}
        </div>
        <h1 class="lining-nums" transition:name={`${post.id}-title`}>{title}</h1>
        {summary ? <p class="article-deck">{summary}</p> : null}
        {
          updatedOn ? (
            <p class="article-updated">
              Updated{' '}
              <time datetime={updatedOn.toISOString()}>
                {updatedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
              </time>
            </p>
          ) : null
        }
      </header>

      {
        headings.length ? (
          <details class="mobile-toc">
            <summary>On this page</summary>
            <TableOfContents headings={headings} />
          </details>
        ) : null
      }

      <div class="article-grid">
        <article class="markdown-content article-prose">
          <Content components={{ a: ExternalLink }} />
        </article>

        {
          headings.length ? (
            <aside class="article-sidebar">
              <TableOfContents headings={headings} />
            </aside>
          ) : null
        }
      </div>
    </div>
  </Section>
</Layout>
