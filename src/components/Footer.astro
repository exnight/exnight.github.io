---
import PageFrame from '@/components/PageFrame.astro'
import SocialIconLink from '@/components/SocialIconLink.astro'
---

<footer class="border-line bg-folio text-folio-ink border-t">
  <PageFrame class="flex min-h-22 items-center justify-between max-[720px]:min-h-20">
    <span class="text-footer text-folio-muted">© {new Date().getFullYear()}</span>
    <nav class="flex gap-[0.65rem]" aria-label="Social profiles">
      <SocialIconLink
        href="https://github.com/exnight"
        label="Leo Wong on GitHub"
        network="github"
      />
      <SocialIconLink
        href="https://www.linkedin.com/in/jyleowong/"
        label="Leo Wong on LinkedIn"
        network="linkedin"
      />
    </nav>
  </PageFrame>
</footer>
