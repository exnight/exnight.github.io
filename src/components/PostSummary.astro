---
import type { CollectionEntry } from 'astro:content'
interface Props {
  post: CollectionEntry<'blog'>
}

import { DATE_FORMAT_DISPLAY } from '@/utils'

const { id, data } = Astro.props.post
const summary = data.summary ? data.summary : 'I forgot to write the summary 😅'
---

<article
  class="rounded-lg border-(--border-muted) p-6 shadow transition-transform hover:-translate-y-1 hover:shadow-lg dark:border"
>
  <a href={`/blog/${id}`} aria-label={data.title}>
    <div class="space-y-4">
      <div>
        <h3 class="transition:name={`${id}-title`} mb-2 text-xl font-semibold">
          {data.title}
        </h3>
        <p class="text-sm leading-relaxed text-(--text-muted)">
          {summary}
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        {
          data.tags?.map((tag) => (
            <span class="text-primary rounded border border-(--border-muted) bg-(--bg-dark) px-2 py-1 text-xs">
              {tag}
            </span>
          ))
        }
      </div>

      <div class="text-secondary flex items-center gap-4 pt-2 text-xs">
        <div class="flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {data.publishedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
        </div>
        <div class="flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {data.readTime + ' min read'}
        </div>
      </div>
    </div>
  </a>
</article>
