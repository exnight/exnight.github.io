---
import type { CollectionEntry } from 'astro:content'
interface Props {
  post: CollectionEntry<'blog'>
}

import { DATE_FORMAT_DISPLAY } from '@/utils'

const { id, data } = Astro.props.post
const summary = data.summary ? data.summary : "Somehow I didn't write the summary 🤷🏻‍♂️🤷🏻‍♂️"
---

<div class="my-2 py-2">
  <h2 class="text-2xl leading-normal font-bold" transition:name={`${id}-title`}>{data.title}</h2>
  <p class="mb-2 text-sm font-light italic">
    {data.publishedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
  </p>
  <p class="mt-4">{summary}</p>
  <div class="text-primary my-2">
    <a href=`/blog/${id}` class="block">Read the post</a>
  </div>
</div>
