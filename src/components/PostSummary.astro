---
import type { CollectionEntry } from 'astro:content'
interface Props {
  post: CollectionEntry<'blog'>
}

import { DATE_FORMAT_DISPLAY } from '@/utils'

const { id, data } = Astro.props.post
const tags = data.tags ?? []
---

<article class="post-row">
  <a href={`/blog/${id}`} aria-label={`Read ${data.title}`}>
    <div class="post-row__date">
      <time datetime={data.publishedOn.toISOString()}>
        {data.publishedOn.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)}
      </time>
      <span>{data.readTime} min read</span>
    </div>

    <div class="post-row__content">
      <h3 class="lining-nums" transition:name={`${id}-title`}>{data.title}</h3>
      {data.summary ? <p>{data.summary}</p> : null}
    </div>

    <div class="post-row__topics">
      {tags.length ? <span>{tags.slice(0, 3).join(' / ')}</span> : <span>General note</span>}
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </div>
  </a>
</article>
