---
import { DATE_FORMAT_DISPLAY } from '@/lib/posts'
import PostTags from './PostTags.astro'
interface Props {
  data: { publishedOn: Date; updatedOn?: Date; readTime: number; tags: string[] }
  article?: boolean
}
const { data, article = false } = Astro.props
const format = (date: Date) => date.toLocaleDateString('en-US', DATE_FORMAT_DISPLAY)
---

<div class:list={['n-entry-meta', article && 'n-article__records']}>
  <p
    class:list={[
      `n-meta text-muted [&>:not(:last-child)]:after:text-strong-hairline [&_time]:text-soft-ink compact:text-[0.68rem] compact:[&>:not(:last-child)]:after:mx-2 flex flex-wrap items-baseline gap-x-0 gap-y-[0.2rem] font-mono text-[0.74rem] tracking-[0.06em] uppercase [&>:not(:last-child)]:after:mx-[0.7rem] [&>:not(:last-child)]:after:content-['·']`,
      article ? 'n-article__meta mt-6 mb-3' : 'm-0',
    ]}
  >
    <time datetime={data.publishedOn.toISOString()}>{format(data.publishedOn)}</time>
    <span>{data.readTime} min read</span>
    {
      article && data.updatedOn && (
        <span>
          Updated <time datetime={data.updatedOn.toISOString()}>{format(data.updatedOn)}</time>
        </span>
      )
    }
  </p>
  {article && data.tags.length > 0 && <PostTags tags={data.tags} />}
</div>
