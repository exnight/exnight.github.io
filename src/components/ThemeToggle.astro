  class="n-theme rounded-compact border-strong-hairline bg-raised-paper text-pen [&:hover]:border-pen [&:hover]:bg-tint active:bg-paper grid size-11 flex-none cursor-pointer place-items-center border transition-[border-color,background-color] duration-180 ease-[ease-out] [[hidden]]:hidden"
  type="button"
  aria-label="Switch to dark theme"
  hidden
>
  <svg
