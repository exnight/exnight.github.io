---
interface Heading {
  text: string
  slug: string
  depth: number
}

interface Props {
  headings: Heading[]
  variant?: 'panel' | 'mobile'
}

const { headings, variant = 'panel' } = Astro.props
---

<nav
  class:list={[
    'bg-paper-raised p-5',
    variant === 'panel'
      ? 'rounded-panel border-line border'
      : 'rounded-b-panel border-line-soft border-t',
  ]}
  aria-label="On this page"
>
  <h2
    class:list={[
      'text-meta mt-0 mb-4 font-bold tracking-[0.14em] uppercase',
      variant === 'mobile' && 'hidden',
    ]}
  >
    On this page
  </h2>
  <ol class="m-0 flex list-none flex-col gap-[0.2rem] p-0">
    {
      headings.map((heading) => (
        <li
          class:list={[
            'min-w-0',
            heading.depth === 3 && 'pl-[0.8rem]',
            heading.depth >= 4 && 'pl-6',
          ]}
        >
          <a
            href={`#${heading.slug}`}
            class="toc-link text-toc-link rounded-control text-muted hover:bg-paper-sage hover:text-ink [&.toc-current]:bg-paper-sage [&.toc-current]:text-ink block px-[0.65rem] py-[0.55rem] leading-[1.35] no-underline [&.toc-current]:font-bold"
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  let wrappingElement: Element | null
  let observeHeaderTags: IntersectionObserver
  let allHeaderTags: NodeListOf<Element>

  function setCurrent(entries: IntersectionObserverEntry[]) {
    const allSectionLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link')

    entries.forEach((entry) => {
      if (!entry.isIntersecting) return

      allSectionLinks.forEach((link) => {
        link.classList.remove('toc-current')
        link.removeAttribute('aria-current')
      })

      document
        .querySelectorAll<HTMLAnchorElement>(`a[href="#${entry.target.id}"].toc-link`)
        .forEach((targetLink) => {
          targetLink.classList.add('toc-current')
          targetLink.setAttribute('aria-current', 'location')
        })
    })
  }

  function initTOC() {
    observeHeaderTags?.disconnect()
    wrappingElement = document.querySelector('.markdown-content')
    if (!wrappingElement) return

    allHeaderTags = wrappingElement.querySelectorAll(':scope > h1, :scope > h2, :scope > h3')
    observeHeaderTags = new IntersectionObserver(setCurrent, {
      root: null,
      rootMargin: '-18% 0px -68% 0px',
      threshold: [0, 1],
    })

    allHeaderTags.forEach((tag) => observeHeaderTags.observe(tag))
  }

  initTOC()
  document.addEventListener('astro:after-swap', initTOC)
</script>
