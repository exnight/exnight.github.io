---
interface Heading {
  text: string
  slug: string
  depth: number
}
interface Props {
  headings: Heading[]
}
const toc = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
let section = 0
---

{
  toc.length > 0 && (
    <nav class="n-toc" aria-label="Contents" data-toc>
      <details open>
        <summary class="text-muted cursor-pointer font-mono text-[0.75rem] font-normal tracking-[0.08em] uppercase">
          Sheet index
        </summary>
        <ol>
          {toc.map((heading) => (
            <li>
              <a
                class:list={[
                  'group rounded-compact [&:hover]:text-pen aria-[current=location]:text-pen flex items-start gap-[0.6rem] py-[0.32rem] pr-2 leading-[1.3] no-underline aria-[current=location]:font-semibold',
                  heading.depth === 3
                    ? 'text-muted pl-[1.95rem] text-[0.86rem]'
                    : 'text-soft-ink text-[0.92rem]',
                ]}
                href={`#${heading.slug}`}
              >
                {heading.depth === 2 && (
                  <span
                    class="border-ink group-aria-[current=location]:border-pen group-aria-[current=location]:bg-pen group-aria-[current=location]:text-raised-paper inline-grid size-[1.35rem] flex-none place-items-center rounded-full border-[1.2px] font-mono text-[0.68rem] leading-none font-medium"
                    aria-hidden="true"
                  >
                    {++section}
                  </span>
                )}
                <span>{heading.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
<script>
  import { initContents } from '@/scripts/article'
  let cleanup: (() => void) | undefined
  function initialize() {
    cleanup?.()
    cleanup = initContents()
  }
  initialize()
  document.addEventListener('astro:page-load', initialize)
  document.addEventListener('astro:before-swap', () => {
    cleanup?.()
    cleanup = undefined
  })
</script>
