---
interface Props {
  direction?: 'left' | 'right'
  class?: string
}

const { direction = 'right', class: className } = Astro.props
const path = direction === 'left' ? 'M19 12H5M11 6l-6 6 6 6' : 'M5 12h14M13 6l6 6-6 6'
---

<svg
  class:list={[
    'fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]',
    className,
  ]}
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <path d={path}></path>
</svg>
