---
import NavIcon from './NavIcon.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header class="border-border bg-background/95 sticky top-0 z-50 border-b backdrop-blur-sm">
  <nav class="mx-auto flex w-9/10 items-center justify-between py-5 lg:w-7/10">
    <a
      href="/"
      aria-label="Go to home page"
      class="no-underline transition-opacity hover:opacity-80"
    >
      <NavIcon />
    </a>
    <div class="inline-flex items-center space-x-4">
      <a
        href="/blog"
        class="text-secondary hover:text-foreground font-medium transition-colors duration-200"
        >Blog</a
      >
      <ThemeToggle />
    </div>
  </nav>
</header>
