---
import NavIcon from './NavIcon.astro'
import Sketch from './Sketch.astro'
import ThemeToggle from './ThemeToggle.astro'
const path = Astro.url.pathname
const links = [
  { label: 'Home', href: '/', current: path === '/' },
  { label: 'Writing', href: '/blog', current: path.startsWith('/blog') },
]
---

<header class="n-header border-b-strong-hairline border-b">
  <nav
    class="n-wrap n-header__inner compact:min-h-15 compact:gap-2 flex min-h-18 items-center justify-between gap-4"
    aria-label="Primary navigation"
  >
    <a
      class="n-brand compact:gap-[0.4rem] inline-flex items-center gap-[0.7rem] no-underline"
      href="/"
      aria-label="Leo Wong, home"
    >
      <span class="n-mark"><NavIcon /></span>
      <span
        class="n-brand__name compact:text-[1rem] narrow:hidden text-[1.1rem] font-[650] tracking-[-0.01em] whitespace-nowrap"
        >Leo Wong</span
      >
      <span class="n-brand__role text-muted compact:hidden font-mono text-[0.78rem] font-normal"
        >/ software engineer</span
      >
    </a>
    <span class="n-nav compact:gap-0 ml-auto flex gap-[clamp(0.75rem,2vw,1.5rem)]">
      {
        links.map((link) => (
          <a
            class="[&:hover]:text-pen compact:px-2 compact:py-[0.65rem] relative px-[0.85rem] py-[0.45rem] text-[1.02rem] font-[550] no-underline"
            href={link.href}
            aria-current={link.current ? 'page' : undefined}
          >
            {link.label}
            {link.current && (
              <Sketch
                kind="circle"
                class="n-nav__circle absolute inset-x-[-0.35rem] inset-y-[-0.2rem] h-[calc(100%+0.4rem)] w-[calc(100%+0.7rem)] [--sketch-stroke:1.6]"
              />
            )}
          </a>
        ))
      }
    </span>
    <ThemeToggle />
  </nav>
</header>
