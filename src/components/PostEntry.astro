---
import type { CollectionEntry } from 'astro:content'
import PostMeta from './PostMeta.astro'
import PostTags from './PostTags.astro'
import Sketch from './Sketch.astro'
interface Props {
  post: CollectionEntry<'blog'>
}
const {
  post: { id, data },
} = Astro.props
---

<a
  class="n-entry rounded-entry-hover compact:grid-cols-[minmax(0,1fr)] compact:gap-3 compact:px-3 compact:pt-[1.2rem] compact:pb-[1.3rem] grid grid-cols-[minmax(0,1fr)_4rem] items-start gap-5 px-4 pt-6 pb-[1.6rem] no-underline transition-[background-color] duration-180 ease-[ease-out] focus-visible:bg-[color-mix(in_srgb,var(--raised)_85%,transparent)] [&:focus-visible_.n-entry__arrow]:opacity-100 [&:hover]:bg-[color-mix(in_srgb,var(--raised)_85%,transparent)] [&:hover_.n-entry__arrow]:opacity-100"
  href={`/blog/${id}`}
>
  <div class="n-entry__body compact:col-start-1 flex min-w-0 flex-col gap-[0.6rem]">
    <h3
      class="n-entry__title compact:text-[1.45rem] m-0 text-[clamp(1.45rem,2.4vw,2.1rem)] leading-[1.08] font-[620] tracking-tight text-balance wrap-anywhere font-stretch-92%"
      transition:name={`${id}-title`}
    >
      {data.title}
    </h3>
    <PostMeta data={data} />
    {
      data.summary && (
        <p class="n-entry__summary text-soft-ink compact:text-base m-0 max-w-[85ch] font-serif text-[1.05rem] leading-normal">
          {data.summary}
        </p>
      )
    }
    {data.tags.length > 0 && <PostTags tags={data.tags} />}
  </div>
  <Sketch
    kind="arrow"
    class="n-entry__arrow compact:hidden h-[1.8rem] w-14 self-center opacity-0 transition-opacity duration-120 ease-[ease-out] [@media(hover:none)]:opacity-100"
  />
</a>

<style>
  @layer components {
    /* The entry owns its pen-drawing effect across the Sketch boundary. */
    .n-entry :global(.n-entry__arrow .n-sketch__draw) {
      stroke-dasharray: 72;
      stroke-dashoffset: 72;
      transition: stroke-dashoffset 380ms ease-out;
    }

    .n-entry:hover :global(.n-sketch__draw),
    .n-entry:focus-visible :global(.n-sketch__draw) {
      stroke-dashoffset: 0;
    }

    @media (hover: none), (prefers-reduced-motion: reduce) {
      .n-entry :global(.n-entry__arrow .n-sketch__draw) {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
