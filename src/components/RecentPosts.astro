---
import PostSummary from './PostSummary.astro'
import { blogPosts } from '@/utils'

const publishedPosts = blogPosts.sort(
  (a, b) => b.data.publishedOn.valueOf() - a.data.publishedOn.valueOf(),
)
---

<h2 class="text-3xl">Recent Posts</h2>
<ul>
  {
    publishedPosts.slice(0, 10).map((post) => (
      <li class="border-primary my-6 duration-300 hover:translate-x-1 hover:border-l-4 hover:pl-4">
        <PostSummary post={post} />
      </li>
    ))
  }
</ul>
