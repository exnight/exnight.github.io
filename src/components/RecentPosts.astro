---
import Section from '@/components/Section.astro'
import PostSummary from '@/components/PostSummary.astro'
import { blogPosts } from '@/utils'

const publishedPosts = blogPosts.sort(
  (a, b) => b.data.publishedOn.valueOf() - a.data.publishedOn.valueOf(),
)
---

<Section id="blog">
  <div class="min-vh-minus-header mx-auto w-10/12 space-y-8 lg:w-3/4">
    <div>
      <h2 class="text-foreground mb-3 text-4xl font-bold">Latest Posts</h2>
      <p class="text-secondary">Thoughts on software engineering, technology, and my hobbies</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {publishedPosts.slice(0, 10).map((post) => <PostSummary post={post} />)}
    </div>
  </div>
</Section>
