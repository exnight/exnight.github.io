---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'

import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="A personal website, blog, and gallery" />
    <title>Leo Wong</title>
    <script is:inline>
      document.addEventListener('astro:after-swap', () => {
        if (localStorage.getItem('vueuse-color-scheme') === 'dark')
          document.documentElement.classList.add('dark')
      })
    </script>

    <ClientRouter />
  </head>
  <body class="bg-background text-slate-800 transition-colors duration-300 dark:text-stone-200">
    <main class="mx-4 h-screen md:mx-auto md:w-10/12">
      <!-- Markup shared across all pages, e.g., NavBar -->
      <Header />
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
