---
// Catch-all prototype route (/prototypes/[...path]), injected by astro.config.mjs in dev
// or with PROTOTYPES=1. Serves the index page and the approved prototype (Drafting Notebook v2).
import ChooserIndex from './ChooserIndex.astro'
import NotebookV2Home from '@/prototypes/finalists/notebook-v2/Home.astro'
import NotebookV2Post from '@/prototypes/finalists/notebook-v2/Post.astro'
import { articleFromPost, finalistPaths, fixtureArticle } from '@/prototypes/finalists/shared/data'
import { prototypesEnabled, type Post } from '@/prototypes/shared/data'

export function getStaticPaths() {
  return prototypesEnabled
    ? [{ params: { path: undefined }, props: { view: 'index' } }, ...finalistPaths()]
    : []
}

const { view, post } = Astro.props as {
  view: 'index' | 'home' | 'post' | 'fixture'
  post?: Post
}

const article =
  view === 'post' && post
    ? await articleFromPost(post)
    : view === 'fixture'
      ? fixtureArticle()
      : undefined
---

{view === 'index' && <ChooserIndex />}
{view === 'home' && <NotebookV2Home />}
{article && <NotebookV2Post article={article} />}
