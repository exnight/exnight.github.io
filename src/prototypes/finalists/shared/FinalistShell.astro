---
import FinalistBar from './FinalistBar.astro'
import { type FinalistId } from './data'
import './base.css'

interface Props {
  finalist: FinalistId
  page: string
  title: string
}

const { finalist, page, title } = Astro.props
---

<!doctype html>
<html lang="en" class={`fx fx-${finalist}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      // Keep the preview preference independent from the production site's theme.
      let theme = 'light'
      try {
        theme = localStorage.getItem('notebook-prototype-theme') || 'light'
      } catch {}
      document.documentElement.dataset.notebookTheme = theme === 'dark' ? 'dark' : 'light'
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Finalist {finalist}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.27/dist/katex.min.css"
      integrity="sha384-Pu5+C18nP5dwykLJOhd2U4Xen7rjScHN/qusop27hdd2drI+lL5KvX7YntvT8yew"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <a class="fx-skip" href="#main-content">Skip to content</a>
    <FinalistBar current={finalist} page={page} />
    <slot />
    <script is:inline>
      // Contents disclosures: open on wide screens, collapsed on narrow ones.
      document.querySelectorAll('details[data-open-above]').forEach((details) => {
        const min = Number(details.dataset.openAbove) + 1
        details.open = window.matchMedia(`(min-width: ${min}px)`).matches
      })
    </script>
    <script>
      // Contents: mark the section currently being read.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]')]
      const targets = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((el): el is HTMLElement => Boolean(el))
      if (targets.length) {
        const setCurrent = (id: string) =>
          links.forEach((link) => {
            if (link.hash.slice(1) === id) link.setAttribute('aria-current', 'location')
            else link.removeAttribute('aria-current')
          })
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((e) => e.isIntersecting)
            if (visible.length) setCurrent(visible[0].target.id)
          },
          { rootMargin: '0px 0px -70% 0px' },
        )
        targets.forEach((target) => observer.observe(target))
      }
    </script>
  </body>
</html>
