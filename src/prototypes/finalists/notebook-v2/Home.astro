---
import NavIcon from '@/components/NavIcon.astro'
import Frame from './Frame.astro'
import Sketch from './Sketch.astro'
import { formatDate, profile, publishedPosts } from '@/prototypes/shared/data'

const posts = publishedPosts().slice(0, 3) // homepage shows recent posts only
const total = publishedPosts().length

// Mark two phrases of the real statement without changing its copy.
const statement = profile.statement
const underline = 'build software'
const highlight = 'notes'
const u = statement.indexOf(underline)
const h = statement.indexOf(highlight)
const canMark = u >= 0 && h > u + underline.length

const groups = [
  { key: 'A', title: 'Profession', items: profile.profession },
  { key: 'B', title: 'Beyond work', items: profile.beyondWork },
]
---

<Frame page="home" title={profile.name}>
  <div class="n-wrap">
    <section class="n-hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="n-hero__statement">
        {
          canMark ? (
            <>
              {statement.slice(0, u)}
              <span class="n-mark-under">
                {underline}
                <Sketch kind="underline" />
              </span>
              {statement.slice(u + underline.length, h)}
              <span class="n-mark-high">
                <Sketch kind="highlight" />
                <span>{highlight}</span>
              </span>
              {statement.slice(h + highlight.length)}
            </>
          ) : (
            statement
          )
        }
      </h1>
      <p class="n-hero__detail">{profile.detail}</p>

      <figure class="n-system" aria-label="Profession and interests">
        <div class="n-system__core">
          <span class="n-system__node"><NavIcon /></span>
        </div>
        <div class="n-system__cards">
          {
            groups.map((group) => (
              <section class="n-system__card" aria-label={group.title}>
                <h2 class="n-mono n-balloon-title">
                  <span class="n-balloon">{group.key}</span> {group.title}
                </h2>
                <ol>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </figure>
    </section>
  </div>

  <section class="n-wrap n-log" id="writing" aria-labelledby="writing-heading">
    <h2 id="writing-heading" class="n-section-title">
      Recent writing
      <Sketch kind="underline" class="n-section-title__mark" />
    </h2>
    <ol class="n-log__list">
      {
        posts.map((post, index) => (
          <li>
            <a class="n-entry" href={`/prototypes/notebook-v2/blog/${post.id}`}>
              <span class="n-balloon n-entry__no" aria-hidden="true">
                {total - index}
              </span>
              <span class="n-entry__body">
                <span class="n-meta">
                  <time datetime={post.data.publishedOn.toISOString()}>
                    {formatDate(post.data.publishedOn)}
                  </time>
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </span>
                <span class="n-entry__title">{post.data.title}</span>
                {post.data.summary ? (
                  <span class="n-entry__summary">{post.data.summary}</span>
                ) : null}
              </span>
              <Sketch kind="arrow" class="n-entry__arrow" />
            </a>
          </li>
        ))
      }
    </ol>
    <a class="n-mono n-all" href="/blog">All writing →</a>
  </section>
</Frame>
