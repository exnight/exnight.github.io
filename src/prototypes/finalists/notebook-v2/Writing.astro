---
import Frame from './Frame.astro'
import Sketch from './Sketch.astro'
import { formatDate, publishedPosts } from '@/prototypes/shared/data'

const posts = publishedPosts()
const years = [...new Set(posts.map((post) => post.data.publishedOn.getFullYear()))]
---

<Frame page="writing" title="Writing">
  <div class="n-wrap n-archive">
    <header class="n-archive__head">
      <h1>Writing<Sketch kind="underline" class="n-archive__mark" /></h1>
      <p>Notes on software and the things I learn beyond it.</p>
      <span class="n-mono n-archive__count"
        >{posts.length} {posts.length === 1 ? 'post' : 'posts'} · newest first</span
      >
    </header>
    {
      years.map((year) => (
        <section class="n-archive__year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="n-mono">
            {year}
          </h2>
          <ol class="n-log__list">
            {posts
              .filter((post) => post.data.publishedOn.getFullYear() === year)
              .map((post) => (
                <li>
                  <a class="n-entry" href={`/prototypes/notebook-v2/blog/${post.id}`}>
                    <span class="n-entry__body">
                      <span class="n-entry__title">{post.data.title}</span>
                      <span class="n-meta">
                        <time datetime={post.data.publishedOn.toISOString()}>
                          {formatDate(post.data.publishedOn)}
                        </time>
                        <span>{post.data.readTime} min read</span>
                      </span>
                      {post.data.summary && (
                        <span class="n-entry__summary">{post.data.summary}</span>
                      )}
                      {post.data.tags.length > 0 && (
                        <span class="n-tags" aria-label="Topics">
                          {post.data.tags.map((tag) => (
                            <span>{tag}</span>
                          ))}
                        </span>
                      )}
                    </span>
                    <Sketch kind="arrow" class="n-entry__arrow" />
                  </a>
                </li>
              ))}
          </ol>
        </section>
      ))
    }
    {
      posts.length === 0 && (
        <p class="n-archive__empty">
          No published notes yet. <a href="/prototypes/notebook-v2/">Back to home</a>.
        </p>
      )
    }
  </div>
</Frame>
